PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lapadi
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
APP_URL=http://localhost:5173

# Emails transactionnels (SMTP auto-heberge ou fournisseur de ton choix)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="La PaDI <no-reply@lapadi.com>"
EMAIL_REPLY_TO=contact@lapadi.com

# Optionnel — uniquement pour le script "npm run migrate:from-supabase"
# (a remplir avec les valeurs de l'ancien projet Supabase/Lovable Cloud)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=